rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validShopId(id) { return id.matches('^[A-HJ-NP-Z2-9]{20}$'); }
    function shopValid(d) {
      // Nested records are validated by the app. The invitation grants access to the whole shop.
      return d.keys().hasOnly(['schemaVersion', 'name', 'createdAt', 'groupOrder', 'categories', 'stopped'])
        && d.schemaVersion == 2 && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.createdAt is int && d.groupOrder is list && d.groupOrder.size() <= 100
        && d.categories is map
        && (!('stopped' in d) || (d.stopped == true && d.categories.size() == 0 && d.groupOrder.size() == 0));
    }
    match /shops/{shopId} {
      // The random shop ID is the invitation. Shops can never be enumerated.
      allow get: if signedIn() && validShopId(shopId);
      allow list, delete: if false;
      allow create: if signedIn() && validShopId(shopId) && shopValid(request.resource.data);
      allow update: if signedIn() && validShopId(shopId) && shopValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && !('stopped' in resource.data);

      // Compatibility reads for the one-time upgrade; new shops need no subcollections.
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && validShopId(shopId)
          && exists(/databases/$(database)/documents/shops/$(shopId))
          && !('stopped' in get(/databases/$(database)/documents/shops/$(shopId)).data)
          && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid;
      }
      match /{kind}/{id} {
        allow read: if kind in ['groups', 'items'] && signedIn()
          && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid))
          && !('stopped' in get(/databases/$(database)/documents/shops/$(shopId)).data);
      }
    }
  }
}
