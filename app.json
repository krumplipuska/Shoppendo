
{
  "expo": {
    "name": "Shoppendo",
    "slug": "shoppendo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shoppendo-icon-square.png",
    "userInterfaceStyle": "light",
    "scheme": "shoppendo",
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "JCF57JAY8Q",
      "bundleIdentifier": "com.tamasbagyinszki.shoppendo.dev",
      "associatedDomains": ["applinks:shoppendo-1a86c.web.app"]
    },
    "android": {
      "package": "com.tamasbagyinszki.shoppendo.dev",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "data": [{ "scheme": "https", "host": "shoppendo-1a86c.web.app", "pathPrefix": "/join/" }],
        "category": ["BROWSABLE", "DEFAULT"]
      }]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Shoppendo",
      "shortName": "Shoppendo",
      "themeColor": "#246B4D"
    },
    "plugins": [
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/shoppendo-splash.png", "imageWidth": 140, "resizeMode": "contain", "backgroundColor": "#F7F7F4" }]
    ]
  }
}
