{
  "name": "shoppendo",
  "description": "Simple local-first shopping lists with shop-ID sharing.",
  "license": "0BSD",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-drax": "^1.1.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.34.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/model.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shoppendo \"node --test tests/firestore.test.mjs\"",
    "export": "expo export --platform all",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-shoppendo",
    "deploy:rules": "firebase deploy --only firestore:rules --project shoppendo-1a86c",
    "check:firebase": "node scripts/check-firebase.mjs"
  }
